# Copy this template to .env and set HUGGINGFACE_TOKEN locally.
# Do not commit a real token.
HUGGINGFACE_TOKEN=

# Model choices for the audio API.
PHOWHISPER_MODEL=vinai/PhoWhisper-base
WHISPER_MODEL=openai/whisper-base
SILERO_LANG95_MODEL=https://huggingface.co/Derur/silero-models/resolve/ab3dfc803ab6384ac507dc81f0d46fd1613058b8/lang95/lang_classifier_95.onnx
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
MODEL_DEVICE=auto

# Private local meeting library storage.
MEETING_DATA_DIR=./meeting-data/postgresql
DATABASE_URL=postgresql://meeting:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/meeting
POSTGRES_DB=meeting
POSTGRES_USER=meeting
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
# Dedicated disposable database for integration tests; never use production data.
TEST_DATABASE_URL=

# Local Google Meet bot. Use a dedicated virtual sink, never the default output.
BOT_CHROME_PATH=
BOT_AUDIO_SINK=
BOT_ADMISSION_TIMEOUT_SECONDS=300

# Opt-in RAG; providers and immutable embedding profiles are server allowlists.
RAG_ENABLED=false
RAG_PROVIDERS_JSON=[]
RAG_EMBEDDING_PROFILES_JSON=[]
RAG_MAX_K=10
RAG_PROMPT_VERSION=meeting_qa_v1
# Initial, uncalibrated retrieval threshold.
RAG_MIN_COSINE_SIMILARITY=0.35

# Local voice profiles; enrollment works while automatic identification is off.
# Remote enrollment/matching requires an immutable 40-character HF commit.
PYANNOTE_REVISION=
VOICE_IDENTIFICATION_ENABLED=false
# Leave unset until approved held-out calibration for the current fingerprint.
# VOICE_MATCH_MIN_COSINE=
# VOICE_MATCH_MIN_MARGIN=
